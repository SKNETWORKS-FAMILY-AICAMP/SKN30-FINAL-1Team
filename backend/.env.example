# 서버 프로세스 안에만 존재하는 값. 외부에 노출되지 않는다.
# 실제 값은 .env 에 채우고, .env 는 절대 커밋하지 않는다.

# 앱
APP_ENV=local
DEBUG=true

# CORS (프론트 개발 서버 주소)
CORS_ORIGINS=http://localhost:5173

# DB (Supabase)
#
# Supabase 대시보드 > Project Settings > Database > Connection string 에서 복사.
# 드라이버 접두사(+asyncpg)는 코드가 자동으로 붙이므로 postgresql:// 그대로 두면 된다.
#
# 반드시 Transaction pooler (포트 6543) 를 쓸 것.
# 앱은 요청마다 짧게 붙었다 떨어지므로 풀러가 맞다.
#
# 스키마 변경은 backend/sql/ 의 SQL 을 Supabase SQL Editor 에서 실행한다.
# psql 로 직접 붙을 때만 포트 5432 를 쓴다 (backend/sql/README.md 참고).
DATABASE_URL=

# 보안
SECRET_KEY=

# 외부 API 키 (프론트가 아니라 반드시 여기에)
OPENAI_API_KEY=
