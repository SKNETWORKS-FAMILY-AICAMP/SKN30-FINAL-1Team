{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* 경로 alias — vite.config.ts 의 resolve.alias 와 반드시 같이 유지할 것
       TS 6 부터 baseUrl 이 deprecated 라 paths 만 둔다 (tsconfig 위치 기준으로 해석됨) */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "strict": true,
    // 맥/윈도우는 파일명 대소문자를 구분하지 않지만 CI(Linux)는 구분한다.
    // 이 옵션이 없으면 로컬은 통과하고 CI에서만 빌드가 깨진다.
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
